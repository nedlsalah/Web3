		<title>NedlSalah — مطور ويب ومختص تسويق رقمي</title>
	</head>
	<body class="bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased selection:bg-brand-red selection:text-white">
		<Navigation />
		<main>
			<Hero />
			<Services />
			<Work />
			<Skills />
			<Experience />
			<Credentials />
			<Testimonials />
			<Contact />
