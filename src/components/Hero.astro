---
---
<section class="relative min-h-[85vh] flex items-center py-20 px-6 overflow-hidden">
  <!-- إضاءة خلفية خفيفة باللون الأحمر -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-red/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto w-full relative z-10">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--border-color)] bg-[var(--bg-secondary)] mb-8">
      <span class="w-2 h-2 rounded-full bg-brand-red animate-pulse"></span>
      <span class="font-mono text-xs uppercase tracking-wider opacity-80">Available for Freelance & Projects</span>
    </div>

    <h1 class="font-display text-5xl sm:text-7xl md:text-8xl font-black tracking-tight leading-[1.05] max-w-4xl">
      Crafting Digital <br />
      <span class="text-brand-red">Experiences</span> That Convert.
    </h1>

    <p class="mt-6 text-lg md:text-xl opacity-75 max-w-2xl leading-relaxed">
      Hi, I'm <strong class="font-semibold text-[var(--text-primary)]">NedlSalah</strong> — a Digital Marketing Specialist, Web Developer, and Graphic Designer based in Abu Dhabi. I blend performance marketing, modern code, and bold visuals to grow brands.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a 
        href="#work" 
        class="px-8 py-4 rounded-lg bg-brand-red hover:bg-brand-red-hover text-white font-semibold transition-all"
      >
        Explore My Work
      </a>
      <a 
        href="#services" 
        class="px-8 py-4 rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:border-brand-red font-semibold transition-all"
      >
        View Services
      </a>
    </div>

    <!-- إحصائيات سريعة -->
    <div class="mt-16 pt-8 border-t border-[var(--border-color)] grid grid-cols-2 sm:grid-cols-3 gap-8 max-w-2xl">
      <div>
        <div class="font-display text-3xl font-black">5+</div>
        <div class="text-sm opacity-60 mt-1">Years Experience</div>
      </div>
      <div>
        <div class="font-display text-3xl font-black">50+</div>
        <div class="text-sm opacity-60 mt-1">Projects Delivered</div>
      </div>
      <div>
        <div class="font-display text-3xl font-black">360°</div>
        <div class="text-sm opacity-60 mt-1">Digital Solutions</div>
      </div>
    </div>
  </div>
</section>