---
// زر تبديل الوضع الداكن/الفاتح
---
<button id="theme-toggle" aria-label="Toggle Dark/Light Mode" class="p-3 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:border-brand-red hover:text-brand-red hover:scale-105 transition-all cursor-icon">
  <!-- أيقونة الشمس (تظهر في الوضع الداكن) -->
  <svg id="sun-icon" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- أيقونة القمر (تظهر في الوضع الفاتح) -->
  <svg id="moon-icon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
  </svg>
</button>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  
  // التحقق من الثيم المحفوظ مسبقاً
  const currentTheme = localStorage.getItem('theme') || 'dark';
  if (currentTheme === 'dark') {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }

  themeToggle?.addEventListener('click', () => {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
