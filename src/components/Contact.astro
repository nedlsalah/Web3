---
---
<section id="contact" class="py-24 px-6 border-t border-[var(--border-color)]">
  <div class="max-w-4xl mx-auto text-center">
    <span class="font-mono text-xs uppercase tracking-widest text-brand-red">Get in Touch</span>
    <h2 class="font-display text-4xl sm:text-6xl font-black tracking-tight mt-3">
      Have a Project <span class="text-brand-red">in Mind?</span>
    </h2>
    <p class="mt-6 text-lg opacity-75 max-w-xl mx-auto leading-relaxed">
      If you need support with digital marketing, website development, visual identity, or creative content, let's discuss your project requirements.
    </p>

    <div class="mt-10">
      <a 
        href="mailto:nedlsalah@gmail.com" 
        class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-red-hover text-white font-semibold text-lg transition-all shadow-lg shadow-brand-red/20 group"
      >
        <span>nedlsalah@gmail.com</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <!-- معلومات التواصل مع أيقونات SVG نظيفة ومتوافقة مع الألوان -->
    <div class="mt-16 pt-8 border-t border-[var(--border-color)] flex flex-wrap justify-center items-center gap-8 font-mono text-xs opacity-80">
      
      <!-- أيقونة الموقع -->
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>Abu Dhabi, UAE</span>
      </div>

      <!-- أيقونة التوفر -->
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-red animate-pulse"></span>
        <span>Available for Projects</span>
      </div>

      <!-- أيقونة اللغات -->
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
        </svg>
        <span>Arabic • English • French</span>
      </div>

    </div>
  </div>
</section>