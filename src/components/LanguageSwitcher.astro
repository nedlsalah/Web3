---
// src/components/LanguageSwitcher.astro
---
<button id="lang-toggle" aria-label="Switch Language" class="px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:border-brand-red hover:text-brand-red font-mono text-xs uppercase transition-all cursor-pointer">
  <span id="lang-label">AR</span>
</button>

<script>
  const langToggle = document.getElementById('lang-toggle');
  const langLabel = document.getElementById('lang-label');

  // التحقق من الحالة المخزنة مسبقاً
  const currentLang = localStorage.getItem('site-lang') || 'en';
  
  if (currentLang === 'ar') {
    document.documentElement.setAttribute('dir', 'rtl');
    document.documentElement.setAttribute('lang', 'ar');
    if (langLabel) langLabel.textContent = 'EN';
  } else {
    document.documentElement.setAttribute('dir', 'ltr');
    document.documentElement.setAttribute('lang', 'en');
    if (langLabel) langLabel.textContent = 'AR';
  }

  langToggle?.addEventListener('click', () => {
    const isAr = document.documentElement.getAttribute('lang') === 'ar';
    
    if (isAr) {
      document.documentElement.setAttribute('lang', 'en');
      document.documentElement.setAttribute('dir', 'ltr');
      localStorage.setItem('site-lang', 'en');
      if (langLabel) langLabel.textContent = 'AR';
    } else {
      document.documentElement.setAttribute('lang', 'ar');
      document.documentElement.setAttribute('dir', 'rtl');
      localStorage.setItem('site-lang', 'ar');
      if (langLabel) langLabel.textContent = 'EN';
    }
    
    // إعادة تحميل خفيفة أو تحديث لتطبيق اتجاه الـ RTL على العناصر
    window.location.reload();
  });
</script>
