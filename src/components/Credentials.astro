---
const certs = [
  { year: "2021", title: "Fundamentals of Digital Marketing", issuer: "Google" },
  { year: "2020", title: "Web Development Track", issuer: "Udacity" },
  { year: "2020", title: "WordPress Website Development", issuer: "OpenClassrooms" },
  { year: "2019", title: "Responsive Web Design Fundamentals", issuer: "Coursera" },
  { year: "2019", title: "Microsoft Office Specialist: Excel", issuer: "Microsoft" }
];
---
<section id="certifications" class="py-24 px-6 border-t border-[var(--border-color)]">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="font-mono text-xs uppercase tracking-widest text-brand-red">Credentials & Learning</span>
        <h2 class="font-display text-4xl md:text-5xl font-black tracking-tight mt-2">
          Certifications
        </h2>
      </div>
      <p class="opacity-70 max-w-md text-sm md:text-base">
        Professional certifications and continuous learning to stay at the forefront of digital standards.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {certs.map((item, index) => (
        <div class="group p-8 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)] hover:border-brand-red hover:-translate-y-2 hover:shadow-2xl hover:shadow-brand-red/10 transition-all duration-300 relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 right-0 w-32 h-32 bg-brand-red/5 rounded-bl-full pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>
          <div>
            <span class="font-mono text-xs px-3 py-1 rounded-full border border-[var(--border-color)] text-brand-red inline-block mb-4 group-hover:bg-brand-red group-hover:text-white transition-colors">
              {item.year}
            </span>
            <h3 class="font-display text-xl font-bold group-hover:text-brand-red transition-colors">{item.title}</h3>
          </div>
          <div class="mt-8 pt-4 border-t border-[var(--border-color)] font-mono text-xs opacity-70 flex justify-between items-center">
            <span>Issuer</span>
            <span class="font-semibold text-[var(--text-primary)]">{item.issuer}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>