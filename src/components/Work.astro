    category: "web",
    categoryLabel: "Websites",
    description: "A corporate website for a business consultancy, developed using WordPress.",
    tech: ["WordPress", "Business"],
    link: "https://fincastra.com/",
    image: "https://nedlsalah.github.io/Web/img/work/fincastra.webp"
  },
  {
    title: "Napa",
    category: "web",
    categoryLabel: "Websites",
    description: "A website for home maintenance services in Abu Dhabi, developed using WordPress.",
    tech: ["WordPress", "Services"],
